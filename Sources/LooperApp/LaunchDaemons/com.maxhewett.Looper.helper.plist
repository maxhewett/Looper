<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.maxhewett.Looper.helper</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/looper</string>
	<key>ProgramArguments</key>
	<array>
		<string>looper</string>
		<string>install</string>
		<string>--service</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>TMPDIR</key>
		<string>/Library/Caches/Looper/tmp</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>WatchPaths</key>
	<array>
		<string>/Library/Application Support/Looper/Requests</string>
	</array>
	<key>StandardOutPath</key>
	<string>/var/log/Looper/looper.out.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/Looper/looper.err.log</string>
</dict>
</plist>
